        "description": { "type": "string" },
        "costPerNight": { "type": "number" },
        "hostId": { "type": "string" },
        "locationType": { "type": "string", "enum": ["APARTMENT", "CAMPSITE", "HOUSE", "SPACESHIP"] },
        "numOfBeds": { "type": "integer" },
        "photoThumbnail": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "latitude": { "type": ["number", "null"] },
        "longitude": { "type": ["number", "null"] },
        "closedForBookings": { "type": "boolean" }
      },
      "required": ["id", "title", "description", "costPerNight", "hostId", "locationType", "numOfBeds", "photoThumbnail", "isFeatured", "closedForBookings"]
    },
    "Listing": {
      "type": "object",
      "description": "The shape returned by GET/POST/PATCH on a single listing: amenities are the full Amenity shape.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "costPerNight": { "type": "number" },
        "hostId": { "type": "string" },
        "locationType": { "type": "string", "enum": ["APARTMENT", "CAMPSITE", "HOUSE", "SPACESHIP"] },
        "numOfBeds": { "type": "integer" },
        "photoThumbnail": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "latitude": { "type": ["number", "null"] },
        "longitude": { "type": ["number", "null"] },
        "closedForBookings": { "type": "boolean" },
        "amenities": { "type": "array", "items": { "$ref": "#/shapes/Amenity" } }
      },
      "required": ["id", "title", "description", "costPerNight", "hostId", "locationType", "numOfBeds", "photoThumbnail", "isFeatured", "closedForBookings"]
    },
