      "key": "get:/listings/{listingId}/totalCost",
      "operation_id": "getListingTotalCost",
      "method": "GET",
      "path": "/listings/{listingId}/totalCost",
      "summary": "Compute the total cost of a stay",
      "description": "totalCost = costPerNight * number of nights between checkInDate and checkOutDate. The source's own guard against invalid dates (`diffInDays === NaN`) can never be true in JavaScript, so malformed dates silently produce a NaN-derived totalCost instead of the 400 the code intends — confirmed by reading the source, not yet reproduced by probe.",
      "tags": ["Listings"],
      "semantics": "read",
      "provenance": "probe",
      "confidence": 1.0,
      "parameters": [
        { "name": "listingId", "in": "path", "required": true, "type": "string" },
        { "name": "checkInDate", "in": "query", "required": true, "type": "string", "format": "date" },
        { "name": "checkOutDate", "in": "query", "required": true, "type": "string", "format": "date" }
      ],
      "request_body": null,
      "response": {
        "status": "200",
        "content_type": "application/json",
        "shape_ref": "#/shapes/TotalCostResponse",
        "root_property_count": 1
