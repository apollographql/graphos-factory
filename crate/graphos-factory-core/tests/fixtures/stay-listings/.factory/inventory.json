    "UpdateListingRequest": {
      "type": "object",
      "properties": {
        "listing": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "costPerNight": { "type": "number" },
            "numOfBeds": { "type": "integer" },
            "hostId": { "type": "string" },
            "locationType": { "type": "string", "enum": ["APARTMENT", "CAMPSITE", "HOUSE", "SPACESHIP"] },
            "photoThumbnail": { "type": "string" },
            "isFeatured": { "type": "boolean" },
            "closedForBookings": { "type": "boolean" },
            "amenities": { "type": "array", "items": { "type": "string" }, "description": "Required by the source: listing.amenities is dereferenced unconditionally." }
          },
          "required": ["amenities"]
        }
      },
      "required": ["listing"]
    }
  },
