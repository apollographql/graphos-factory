    {
      "key": "patch:/listings/{listingId}",
      "operation_id": "updateListing",
      "method": "PATCH",
      "path": "/listings/{listingId}",
      "summary": "Edit a listing",
      "description": "req.body.listing.amenities is dereferenced unconditionally: an update payload with no listing.amenities throws inside setAmenities(), which Railway's edge reports as a 502 (the Node process itself fails, not a handled app error). Confirmed live: listing.update() had already committed title/description/costPerNight/locationType/isFeatured/closedForBookings before the throw, so a request missing listing.amenities is NOT atomic — earlier fields persist even though the response is an error.",
      "tags": ["Listings"],
      "semantics": "write",
      "provenance": "probe",
      "confidence": 1.0,
      "parameters": [
        { "name": "listingId", "in": "path", "required": true, "type": "string" }
      ],
      "request_body": {
        "content_type": "application/json",
        "required": true,
        "shape_ref": "#/shapes/UpdateListingRequest"
      },
      "response": {
        "status": "200",
        "content_type": "application/json",
        "shape_ref": "#/shapes/Listing"
      },
      "errors": [
        { "status": "400", "description": "No listing with the given id. Plain-text body, not JSON.", "shape_ref": null },
        { "status": "502", "description": "listing.amenities missing from the request body: an unhandled exception crashes the request. Body is Railway's own gateway-error JSON ({status, code, message, request_id}), not the app's. Confirmed live.", "shape_ref": "#/shapes/RailwayGatewayError" }
      ],
      "support": "supported",
      "support_reason": null
    }
