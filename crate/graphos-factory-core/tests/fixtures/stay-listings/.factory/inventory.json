        "hostId": { "type": "string" },
        "locationType": { "type": "string", "enum": ["APARTMENT", "CAMPSITE", "HOUSE", "SPACESHIP"], "description": "Closed by selection.yaml decision D-0001: only these 4 values have ever been observed (across 8+ samples and 2 probed writes), and this is fixed Odyssey course data, not open user input." },
        "numOfBeds": { "type": "integer" },
        "photoThumbnail": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "latitude": { "type": ["number", "null"] },
        "longitude": { "type": ["number", "null"] },
        "closedForBookings": { "type": "boolean" },
        "amenities": { "type": "array", "items": { "$ref": "#/shapes/AmenityRef" } }
      },
      "required": ["id", "title", "description", "costPerNight", "hostId", "locationType", "numOfBeds", "photoThumbnail", "isFeatured", "closedForBookings", "amenities"]
    },
    "ListingBare": {
      "type": "object",
