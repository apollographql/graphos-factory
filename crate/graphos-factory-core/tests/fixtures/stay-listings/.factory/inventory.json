            "description": { "type": "string", "default": "" },
            "costPerNight": { "type": "number", "default": 0 },
            "numOfBeds": { "type": "integer" },
            "hostId": { "type": "string", "default": "user-4" },
            "locationType": { "type": "string", "enum": ["APARTMENT", "CAMPSITE", "HOUSE", "SPACESHIP"], "default": "CAMPSITE" },
            "photoThumbnail": { "type": "string", "default": "https://res.cloudinary.com/apollographql/image/upload/v1644353890/odyssey/federation-course2/illustrations/listings-10.png" },
            "isFeatured": { "type": "boolean", "default": false },
            "closedForBookings": { "type": "boolean", "default": false },
            "amenities": { "type": "array", "items": { "type": "string" }, "description": "Amenity ids to associate; omitted means none." }
          },
