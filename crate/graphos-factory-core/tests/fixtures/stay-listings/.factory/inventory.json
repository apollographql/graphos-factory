        { "name": "sortBy", "in": "query", "required": false, "type": "string", "description": "Only the literal value COST_ASC changes the sort to ascending cost; any other value (including absent) sorts descending." },
        { "name": "numOfBeds", "in": "query", "required": false, "type": "integer", "default": 1, "description": "Minimum number of beds (inclusive)." }
