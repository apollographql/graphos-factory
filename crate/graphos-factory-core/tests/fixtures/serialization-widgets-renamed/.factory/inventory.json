          "type": "string"
        },
        "memo": {
          "type": "string"
        },
        "labels": {
          "type": "array"
        },
        "site": {
          "$ref": "#/shapes/Site"
        }
      }
    },
    "Site": {
      "type": "object",
      "properties": {
        "town": {
          "type": "string"
        },
        "postal": {
          "type": "string"
        }
      }
    }
  }
