{
  "operations": [
    {
      "key": "get:/gizmos",
      "method": "GET",
      "path": "/gizmos"
    },
    {
      "key": "post:/gizmos/search",
      "method": "POST",
      "path": "/gizmos/search",
      "request_body": {
        "shape_ref": "#/shapes/SearchGizmosRequest"
      }
    },
    {
